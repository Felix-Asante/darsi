# Values for docker-compose.prod.yml. Copy to .env next to it (never commit the copy).
# Use URL-safe secrets (e.g. `openssl rand -hex 32`): the passwords go inside connection URLs.

# Postgres superuser, used only by the migrate service.
POSTGRES_PASSWORD=
# Password for the non-superuser runtime role `darsi_app`, created by the first migration.
DATABASE_APP_PASSWORD=

# Public URLs, e.g. https://api.example.com and https://app.example.com
API_URL=
APP_URL=
# Comma-separated; `*.` matches school subdomains, e.g. https://app.example.com,https://*.example.com
CORS_ORIGINS=
# Shared parent domain of the app and the API, e.g. .example.com
COOKIE_DOMAIN=
# At least 32 characters.
AUTH_SECRET=

# Resend
RESEND_API_KEY=
MAIL_FROM=Darsi <no-reply@example.com>

# Cloudflare R2 (or any S3-compatible storage)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=darsi
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional
LOG_LEVEL=info
API_PORT=8080
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TURNSTILE_SECRET_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
