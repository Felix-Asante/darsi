NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# Runtime role: created by the first migration with these credentials. Must not be a superuser.
DATABASE_URL=postgres://darsi_app:change_me@localhost:5432/darsi
# Schema owner, used only by `npm run migration:run`.
DATABASE_MIGRATOR_URL=postgres://postgres:postgres@localhost:5432/darsi

REDIS_URL=redis://localhost:6379

CORS_ORIGINS=http://localhost:3000,http://*.localhost:3000
AUTH_SECRET=